# =====================================================================
# Pixellap API — PRODUCTION environment (api.pixellap.com)
# Copy to /var/www/pixellap-api/.env on the server and fill every value
# marked CHANGE_ME. Never commit the real file. See deploy/README.md.
# After editing: bash deploy/scripts/deploy-api.sh (re-caches the config).
# =====================================================================

# --- Application ------------------------------------------------------
APP_NAME=Pixellap
# Must be "production": no default admin is seeded, /admin is HTTPS-only.
APP_ENV=production
# Generate once on the server: php artisan key:generate   (keep it forever —
# changing it logs everyone out and breaks encrypted values)
APP_KEY=
# Never true in production (shows stack traces and secrets).
APP_DEBUG=false
# Public URL of the API + admin (media URLs are built from it).
APP_URL=https://api.pixellap.com
APP_TIMEZONE=Asia/Dubai

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# "php artisan down" state is stored in a file.
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging ----------------------------------------------------------
# One file per day in storage/logs, kept 14 days.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (MySQL 8 on the same server) ------------------------------
# provision.sh creates the database and user and writes the password to
# /root/pixellap-mysql.txt — copy it here.
DB_CONNECTION=mysql
# "localhost" = Unix socket (the MySQL user is created as 'pixellap'@'localhost').
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=pixellap
DB_USERNAME=pixellap
DB_PASSWORD=CHANGE_ME

# --- Sessions (admin panel) -------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# The admin cookie is only sent to this host...
SESSION_DOMAIN=api.pixellap.com
# ...and only over HTTPS (logging in over plain HTTP is impossible).
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Cache, queue, files ----------------------------------------------
CACHE_STORE=database
# Jobs (website revalidation, contact emails, admin notifications) run in
# the pixellap-queue systemd service.
QUEUE_CONNECTION=database
# Uploaded media live in storage/app/public, served by Nginx at /storage.
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log

# --- Mail (SMTP) ------------------------------------------------------
# Use your mail provider's SMTP credentials (e.g. Google Workspace, Zoho,
# Microsoft 365, Mailgun, Postmark, Amazon SES).
#   Port 587 + MAIL_SCHEME=smtp  -> STARTTLS (most providers)
#   Port 465 + MAIL_SCHEME=smtps -> implicit TLS
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.CHANGE_ME.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
# Sender shown on emails. Must be allowed by your provider (SPF/DKIM on pixellap.com).
MAIL_FROM_ADDRESS="no-reply@pixellap.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Pixellap -----------------------------------------------------------
# Public website (CORS origin + "View website" link in the admin).
FRONTEND_URL=https://pixellap.com
# Where the API tells Next.js to refresh pages. Same server -> loopback,
# no TLS round-trip through Nginx.
FRONTEND_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
# Shared secrets (at least 32 characters each). Generate with:
#   openssl rand -hex 32
# REVALIDATE_SECRET and API_SITE_KEY must be identical in
# /var/www/pixellap-web/shared/.env.production.local
REVALIDATE_SECRET=CHANGE_ME
API_SITE_KEY=CHANGE_ME
# Fallback recipient for contact-form emails when the "email" setting
# (Admin → Settings) is empty or invalid.
CONTACT_NOTIFY_EMAIL=CHANGE_ME@pixellap.com

# Not used (no Redis / S3 on this server).
# REDIS_HOST=127.0.0.1
# AWS_ACCESS_KEY_ID=
