# Laravel queue worker: website revalidation, contact emails, admin notifications.
# -> /etc/systemd/system/pixellap-queue.service (provision.sh)
# `php artisan queue:restart` (deploy-api.sh) makes the worker exit after its current job;
# systemd starts it again with the new code. --max-time recycles it hourly anyway.
[Unit]
Description=Pixellap API queue worker
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/pixellap-api
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=append:/var/log/pixellap/queue.log
StandardError=append:/var/log/pixellap/queue.log

[Install]
WantedBy=multi-user.target
