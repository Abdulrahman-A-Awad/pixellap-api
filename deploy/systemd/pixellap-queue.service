# Laravel queue worker: website revalidation, contact emails, admin notifications.
# -> /etc/systemd/system/pixellap-queue.service (provision.sh)
# deploy-api.sh runs `systemctl restart pixellap-queue` (SIGTERM: the current job finishes first),
# so the worker runs the new code. --max-time recycles it hourly anyway.
[Unit]
Description=Pixellap API queue worker
After=network.target mysql.service
Wants=mysql.service
# Not before the app is installed (it would crash-loop every 5 s until the first deploy).
ConditionPathExists=/var/www/pixellap-api/.env
ConditionPathExists=/var/www/pixellap-api/vendor/autoload.php

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/pixellap-api
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=append:/var/log/pixellap/queue.log
StandardError=append:/var/log/pixellap/queue.log

[Install]
WantedBy=multi-user.target
