# -> /etc/logrotate.d/pixellap (provision.sh)
# Queue worker, PHP-FPM pool, backups and the PM2 (Next.js) logs.
# Laravel's own logs rotate daily by themselves (LOG_CHANNEL=daily, 14 days).
/var/log/pixellap/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su deploy deploy
}
